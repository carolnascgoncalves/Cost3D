  "components": {
    "schemas": {
      "Entrada": {
        "type": "object",
        "properties": {
          "nome": { "type": "string", "maxLength": 150, "minLength": 2 },
          "telefone": { "type": "string", "maxLength": 150, "minLength": 0 },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 150,
            "minLength": 0
          },
          "observacoes": { "type": "string", "maxLength": 500, "minLength": 0 },
          "versao": { "type": "integer", "format": "int64", "minimum": 0 }
        },
        "required": ["nome"]
      },
      "Cliente": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "versao": { "type": "integer", "format": "int64" },
          "nome": { "type": "string" },
          "telefone": { "type": "string" },
          "email": { "type": "string" },
          "observacoes": { "type": "string" },
          "arquivado": { "type": "boolean" }
        }
      },
      "SessaoWeb": {
        "type": "object",
        "properties": {
          "accessToken": { "type": "string" },
          "tokenType": { "type": "string" },
          "expiresIn": { "type": "integer", "format": "int64" }
        }
      },
      "Login": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 150,
            "minLength": 0
          },
          "senha": { "type": "string", "maxLength": 72, "minLength": 0 }
        },
        "required": ["email", "senha"]
      },
      "AlterarSenhaRequest": {
        "type": "object",
        "properties": {
          "senhaAtual": { "type": "string", "minLength": 1 },
          "novaSenha": { "type": "string", "maxLength": 72, "minLength": 12 },
          "confirmarNovaSenha": { "type": "string", "minLength": 1 }
        },
        "required": ["confirmarNovaSenha", "novaSenha", "senhaAtual"]
      },
      "Renovar": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1,
            "pattern": "[A-Za-z0-9_-]{43}"
          }
        },
        "required": ["refreshToken"]
      },
      "Tokens": {
        "type": "object",
        "properties": {
          "accessToken": { "type": "string" },
          "refreshToken": { "type": "string" },
          "tokenType": { "type": "string" },
          "expiresIn": { "type": "integer", "format": "int64" },
          "refreshExpiraEm": { "type": "string", "format": "date-time" }
        }
      },
      "Arquivo": {
        "type": "object",
        "properties": { "arquivado": { "type": "boolean" } },
        "required": ["arquivado"]
      },
      "LoteResumo": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "nome": { "type": "string" },
          "unidades": { "type": "integer", "format": "int32" },
          "vendidas": { "type": "integer", "format": "int32" },
          "disponiveis": { "type": "integer", "format": "int64" },
          "preco": { "type": "string" }
        }
      },
      "PaginaResponseLoteResumo": {
        "type": "object",
        "properties": {
          "itens": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/LoteResumo" }
          },
          "pagina": { "type": "integer", "format": "int32" },
          "tamanho": { "type": "integer", "format": "int32" },
          "total": { "type": "integer", "format": "int64" }
        }
      },
      "Tema": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "nome": { "type": "string" },
          "corPrimaria": { "type": "string" },
          "corDestaque": { "type": "string" },
          "corFundo": { "type": "string" },
          "versao": { "type": "integer", "format": "int64" },
          "logoUrl": { "type": "string" }
        }
      },
      "FilamentoCatalogo": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "nome": { "type": "string" },
          "cor": { "type": "string" },
          "estoque": { "type": "string" },
          "codigoCor": { "type": "string" },
          "pesoRolo": { "type": "string" },
          "marca": { "type": "string" },
          "precoRolo": { "type": "string" }
        }
      },
      "InicioLoja": {
        "type": "object",
        "properties": {
          "recentes": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Recente" }
          },
          "aguardandoVenda": { "type": "integer", "format": "int64" },
          "estoqueCritico": { "$ref": "#/components/schemas/FilamentoCatalogo" }
        }
      },
      "Recente": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "nome": { "type": "string" },
          "situacao": { "type": "string" }
        }
      },
      "Abertura": {
        "type": "object",
        "properties": {
          "registros": { "type": "integer", "format": "int64" },
          "gramas": { "type": "string" }
        }
      },
      "Extrato": {
        "type": "object",
        "properties": {
          "movimentacoes": {
            "$ref": "#/components/schemas/PaginaResponseMovimentacaoResponse"
          },
          "resumo": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Resumo" }
          },
          "abertura": { "$ref": "#/components/schemas/Abertura" },
          "pecasVendidas": { "type": "string" }
        }
      },
      "MovimentacaoResponse": {
        "type": "object",
